@model web.Models.Player

@{
    ViewData["Title"] = "Edit Player";
}

<div class="player-edit">
    <h1 style="color: #FFD700; text-align: center; text-shadow: 0 0 10px #FF4500;">Edit Player</h1>

    <form asp-action="Edit" style="margin-top: 20px;">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="ID_player" />

        <div class="form-group">
            <label asp-for="Username" class="control-label" style="color: #FFD700;">Username</label>
            <input asp-for="Username" class="form-control custom-input" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email" class="control-label" style="color: #FFD700;">Email</label>
            <input asp-for="Email" class="form-control custom-input" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password" class="control-label" style="color: #FFD700;">Password</label>
            <input asp-for="Password"  class="form-control custom-input" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Balance" class="control-label" style="color: #FFD700;">Balance</label>
            <input asp-for="Balance" class="form-control custom-input" />
            <span asp-validation-for="Balance" class="text-danger"></span>
        </div>

        <div class="form-buttons">
            <button type="submit" class="btn btn-primary custom-save-btn">Save Changes</button>
            <a asp-action="Index" class="btn btn-secondary custom-cancel-btn">Cancel</a>
        </div>
    </form>
</div>

<style>
/* Splošni stil za stran */
.player-edit {
    background-color: #2C2C2C; /* Temno ozadje za casino občutek */
    color: white;
    padding: 30px;
    border-radius: 10px;
    box-shadow: 0 0 15px rgba(0, 0, 0, 0.5);
    margin: 20px auto;
    max-width: 500px; /* Omejimo širino obrazca */
}

/* Stil za vhodna polja */
.custom-input {
    background-color: #3C3C3C;
    color: white;
    border: 1px solid #FFD700;
    border-radius: 5px;
    padding: 10px;
    transition: all 0.3s ease;
}

.custom-input:focus {
    background-color: #444;
    border-color: #FF4500;
    box-shadow: 0 0 10px #FF4500;
}

/* Stil za gumbe */
.custom-save-btn {
    background-color: #28A745; /* Zelena za potrditvena dejanja */
    color: white;
    border: none;
    padding: 10px 20px;
    text-transform: uppercase;
    border-radius: 5px;
    transition: all 0.3s ease;
    text-decoration: none;
    margin-right: 10px;
}

.custom-save-btn:hover {
    background-color: #2ECC71; /* Svetlejša zelena ob hoverju */
    color: black;
}

.custom-cancel-btn {
    background-color: #3C3C3C;
    color: white;
    border: 1px solid #FFD700;
    padding: 10px 20px;
    text-transform: uppercase;
    border-radius: 5px;
    transition: all 0.3s ease;
    text-decoration: none;
}

.custom-cancel-btn:hover {
    background-color: #444;
    color: #FFD700;
    border-color: #FF4500;
}
</style>
